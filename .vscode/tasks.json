{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "HEMTT check",
            "command": "hemtt.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "check",
                "--pedantic"
            ],
            "problemMatcher": []
        },
        {
            "label": "HEMTT build",
            "command": "hemtt.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "HEMTT launch",
            "command": "hemtt.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "launch"
            ],
            "problemMatcher": []
        }
    ]
}
